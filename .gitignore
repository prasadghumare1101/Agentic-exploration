# Secrets — never commit real environment files. Keep only *.env.example.
.env
**/.env

# Colcon build artifacts (in case this workspace is ever tracked directly).
build/
install/
log/


# Node modules — restored by `npm ci` from package-lock.json (78 MB otherwise).
**/node_modules/
**/dist/

# Python bytecode.
__pycache__/
*.pyc

# Runtime output — service logs, PX4 flight logs, SLAM databases.
**/logs/
*.log
*.ulg
*.db

# Docker build staging — regenerated by docker/build.sh.
docker/context/

# aero_gcs was studied as a REFERENCE only — it is a separate console project and is not
# part of the AEGIS swarm system published here.
aero_gcs/

# Stray working images at the repo root.
/*.png
