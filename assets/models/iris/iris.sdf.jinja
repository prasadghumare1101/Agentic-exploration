    <!-- 1. Downward RGB Camera (from sjtu_drone) -->
    <link name='downward_camera_link'>
      <pose>0 0 -0.05 0 1.5708 0</pose> <!-- pointing down -->
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name='downward_camera' type='camera'>
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>   <!-- Frustum visualization -->
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name='downward_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>{{ ns }}</namespace>
            <remapping>image_raw:=downward_camera</remapping>
            <remapping>camera_info:=downward_camera_info</remapping>
          </ros>
          <camera_name>downward_camera</camera_name>
          <frame_name>{{ frame_prefix }}downward_camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name='downward_camera_joint' type='fixed'>
      <parent>base_link</parent>
      <child>downward_camera_link</child>
    </joint>

    <!-- 2. Sonar (Ultrasound) - from sjtu_drone -->
    <link name='sonar_link'>
      <pose>0 0 -0.05 0 1.5708 0</pose> <!-- pointing down -->
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-05</iyy><iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <sensor name='sonar' type='ray'>
        <always_on>1</always_on>
        <visualize>1</visualize>
        <update_rate>5</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.12</min_angle>
              <max_angle>0.12</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.12</min_angle>
              <max_angle>0.12</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>10</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name='sonar_plugin' filename='libgazebo_ros_ray_sensor.so'>
          <ros>
            <namespace>{{ ns }}</namespace>
            <remapping>~/out:=sonar</remapping>
          </ros>
          <output_type>sensor_msgs/Range</output_type>
          <radiation_type>ultrasound</radiation_type>
          <frame_name>{{ frame_prefix }}sonar_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name='sonar_joint' type='fixed'>
      <parent>base_link</parent>
      <child>sonar_link</child>
    </joint>

    <!-- ================= EXISTING SENSORS (with frustum visualization enabled) ================= -->

    <!-- Front Camera (existing, now with visualize=1) -->
    <link name='front_camera_link'>
      <pose>0.15 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name='front_camera' type='camera'>
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>   <!-- Frustum visualization -->
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name='front_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>{{ ns }}</namespace>
            <remapping>image_raw:=front_camera</remapping>
            <remapping>camera_info:=front_camera_info</remapping>
          </ros>
          <camera_name>front_camera</camera_name>
          <frame_name>{{ frame_prefix }}front_camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name='front_camera_joint' type='fixed'>
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <!-- Downward Depth Camera (existing, now with visualize=1) -->
    <link name='downward_depth_camera_link'>
      <pose>0 0 -0.05 0 1.5708 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name='downward_depth_camera' type='depth'>
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>   <!-- Frustum visualization -->
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <!-- far raised 20->60 m so the downward camera reaches the ground for SLAM
               mapping from >40 m altitude (edge range at 45 m / 30deg FOV is ~52 m). -->
          <clip>
            <near>0.1</near>
            <far>60.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name='downward_depth_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>{{ ns }}</namespace>
            <remapping>image_raw:=downward_depth_camera</remapping>
            <remapping>camera_info:=downward_depth_camera_info</remapping>
          </ros>
          <camera_name>downward_depth_camera</camera_name>
          <frame_name>{{ frame_prefix }}downward_depth_camera_link</frame_name>
          <min_depth>0.1</min_depth>
          <max_depth>20.0</max_depth>
        </plugin>
      </sensor>
    </link>
    <joint name='downward_depth_camera_joint' type='fixed'>
      <parent>base_link</parent>
      <child>downward_depth_camera_link</child>
    </joint>

    <!-- LiDAR 2D (existing, no frustum needed) -->
    <link name='lidar_link'>
      <pose>0.15 0 0.1 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name='lidar_2d' type='ray'>
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>40</update_rate>
        <visualize>0</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14</min_angle>
              <max_angle>3.14</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name='lidar_2d_plugin' filename='libgazebo_ros_ray_sensor.so'>
          <ros>
            <namespace>{{ ns }}</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>{{ frame_prefix }}lidar_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name='lidar_joint' type='fixed'>
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- LiDAR 3D (existing) -->
    <link name='lidar_3d_link'>
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name='lidar_3d' type='ray'>
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <!-- SITL perf: 10Hz + 180x8 rays (was 20Hz + 360x16) = ~8x fewer ray-casts/s so
             Gazebo can sim 3 drones' 3D lidars near real-time. Plenty for SLAM mapping. -->
        <update_rate>10</update_rate>
        <visualize>0</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.26</min_angle>
              <max_angle>0.26</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name='lidar_3d_plugin' filename='libgazebo_ros_ray_sensor.so'>
          <ros>
            <namespace>{{ ns }}</namespace>
            <remapping>~/out:=scan_3d</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>{{ frame_prefix }}lidar_3d_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name='lidar_3d_joint' type='fixed'>
      <parent>base_link</parent>
      <child>lidar_3d_link</child>
    </joint>

  </model>
</sdf>
