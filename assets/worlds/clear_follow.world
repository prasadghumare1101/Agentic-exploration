<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <scene><ambient>0.9 0.9 0.9 1</ambient><background>0.7 0.8 0.95 1</background><shadows>false</shadows></scene>
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver><type>quick</type><iters>10</iters><sor>1.3</sor><use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling></solver>
        <constraints><cfm>0</cfm><erp>0.2</erp><contact_max_correcting_vel>100</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <!-- CRITICAL: magnetometer reference. Without it the EKF can't align yaw
           (heading_good_for_control stays false) and the drone can never arm. -->
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>

    <!-- UPRIGHT walking person, scale 1.0 (no float/tilt), RADIAL path toward/away from origin -->
    <actor name="moving_person">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop><delay_start>0.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time>  <pose>6 0 0 0 0 0</pose></waypoint>
          <waypoint><time>10</time> <pose>18 0 0 0 0 0</pose></waypoint>
          <waypoint><time>11</time> <pose>18 0 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>21</time> <pose>6 0 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>22</time> <pose>6 0 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- MOVING CAR: prius-hybrid mesh actor, drives a straight leg parallel to the person,
         offset to North=-8 so both targets are visible to the drone without colliding. -->
    <actor name="moving_car">
      <link name="body">
        <visual name="car_visual">
          <pose>0 0 0.6 0 0 1.5708</pose>
          <geometry>
            <mesh><uri>model://prius_hybrid/meshes/Hybrid.obj</uri><scale>0.01 0.01 0.01</scale></mesh>
          </geometry>
        </visual>
      </link>
      <animation name="drive"><filename>walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop><delay_start>0.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="drive">
          <waypoint><time>0</time>  <pose>6 -8 0 0 0 0</pose></waypoint>
          <waypoint><time>12</time> <pose>18 -8 0 0 0 0</pose></waypoint>
          <waypoint><time>13</time> <pose>18 -8 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>25</time> <pose>6 -8 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>26</time> <pose>6 -8 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- MOVING TRUCK (ambulance mesh) as the 3rd distinct target, offset to North=+8.
         Targets: person @ N=0, car @ N=-8, truck @ N=+8 — all visible, non-colliding. -->
    <actor name="moving_truck">
      <link name="body">
        <visual name="truck_visual">
          <pose>0 0 1.0 0 0 1.5708</pose>
          <geometry>
            <mesh><uri>model://ambulance/meshes/ambulance.obj</uri><scale>0.0254 0.0254 0.0254</scale></mesh>
          </geometry>
        </visual>
      </link>
      <animation name="drive"><filename>walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop><delay_start>0.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="drive">
          <waypoint><time>0</time>  <pose>6 8 0 0 0 0</pose></waypoint>
          <waypoint><time>12</time> <pose>18 8 0 0 0 0</pose></waypoint>
          <waypoint><time>13</time> <pose>18 8 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>25</time> <pose>6 8 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>26</time> <pose>6 8 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
