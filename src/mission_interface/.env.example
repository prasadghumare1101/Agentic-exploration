# Sample environment for the mission_interface LLM layer.
# Copy to `.env` and fill in your real values — `.env` is gitignored and must
# never be committed. These are consumed by llm_client.py when the real
# Hugging Face backend replaces the Stage 1 deterministic stub.

# Hugging Face access token (placeholder — replace with your own, keep it secret).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Both ids must name a model the Hugging Face router actually serves, otherwise every
# request comes back as "not supported by any provider you have enabled" — which reads
# like an account permissions problem but is really just a wrong id. List what is served:
#   curl -H "Authorization: Bearer $HF_TOKEN" https://router.huggingface.co/v1/models

# Primary high-level mission-intent model.
HF_MODEL_ID_PRIMARY=Qwen/Qwen2.5-72B-Instruct

# Secondary / fallback model (smaller, faster).
HF_MODEL_ID_SECONDARY=meta-llama/Llama-3.1-8B-Instruct
